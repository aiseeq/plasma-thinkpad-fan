#!/bin/bash
# Reports cooling state for the ThinkPad Fan Control plasmoid.
#
# Output: <level>|<thinkfan state>|<average CPU MHz>|<thermal throttle counter>|<hold state>
#
# The plasmoid compares the throttle counter between polls: a growing counter
# means thermal throttle events occurred since the previous poll. We deliberately use *_count and
# not *_total_time_ms — the latter stays 0 on several Intel generations
# (confirmed on Meteor Lake / Core Ultra 155H).
#
# Runs unprivileged: everything here is world-readable.

FAN=/proc/acpi/ibm/fan
THROTTLE=/sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_count

level=$(awk '/^level:/{print $2}' "$FAN" 2>/dev/null)
[[ -n "$level" ]] || level="n/a"

freq=$(awk '/cpu MHz/{s+=$4; n++} END{if (n) printf "%d", s/n; else print "unavailable"}' /proc/cpuinfo 2>/dev/null)
[[ -n "$freq" ]] || freq=unavailable
count=$(cat "$THROTTLE" 2>/dev/null) || count=unavailable
[[ "$count" =~ ^[0-9]+$ ]] || count=unavailable
hold=$(systemctl is-active thinkpad-fan-hold.service 2>/dev/null) || :
case "$hold" in active|inactive) ;; *) hold=unknown ;; esac

printf '%s|%s|%s|%s|%s\n' \
    "$level" \
    "$(systemctl is-active thinkfan.service 2>/dev/null)" \
    "$freq" \
    "$count" \
    "$hold"
