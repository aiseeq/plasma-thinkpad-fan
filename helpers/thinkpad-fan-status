#!/bin/bash
# Reports cooling state for the ThinkPad Fan Control plasmoid.
#
# Output: <level>|<thinkfan state>|<average CPU MHz>|<thermal throttle counter>|<hold state>
#
# The plasmoid compares the throttle counter between polls: a growing counter
# means thermal throttle events occurred since the previous poll. We deliberately use *_count and
# not *_total_time_ms — the latter stays 0 on several Intel generations
# (confirmed on Meteor Lake / Core Ultra 155H).
#
# Runs unprivileged: everything here is world-readable.

FAN=/proc/acpi/ibm/fan
THROTTLE=/sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_count

read -r level freq count < <(awk '
    FILENAME == ARGV[1] && /^level:/ && level == "" { level=$2 }
    FILENAME == ARGV[2] && /cpu MHz/ { sum += $4; n++ }
    FILENAME == ARGV[3] && FNR == 1 { count=$0 }
    END {
        if (level == "") level="n/a"
        if (n) freq=int(sum/n); else freq="unavailable"
        if (count !~ /^[0-9]+$/) count="unavailable"
        printf "%s %s %s\n", level, freq, count
    }
' "$FAN" /proc/cpuinfo "$THROTTLE" 2>/dev/null)
[[ -n "$level" ]] || level="n/a"
[[ -n "$freq" ]] || freq=unavailable
[[ "$count" =~ ^[0-9]+$ ]] || count=unavailable

states=$(systemctl is-active thinkfan.service thinkpad-fan-hold.service 2>/dev/null) || :
mapfile -t unit_states <<< "$states"
thinkfan=${unit_states[0]:-}
hold=${unit_states[1]:-}
# failed: hold exited with an error (protection gave up, a write failed) — the widget warns about it.
case "$hold" in active|inactive|failed) ;; *) hold=unknown ;; esac

printf '%s|%s|%s|%s|%s\n' \
    "$level" \
    "$thinkfan" \
    "$freq" \
    "$count" \
    "$hold"
