#!/bin/bash
# Keeps the ThinkPad fan pinned at a level.
#
# The embedded controller (and thinkfan, if running) can overwrite a manual
# level, so this helper watches it and restores it when it changes. We write only
# when the level differs: on some fans, every write restarts the EC's spin-up
# ramp, and repeated writes kept the fan near 2000 RPM instead of the requested
# speed.
#
# If temperature protection is unavailable or a temperature read fails, the
# hold is released and automatic control is restored. Set THINKPAD_FAN_TCRIT=0
# to disable protection (not advised for low levels — level 0 means no airflow).
set -u

FAN=/proc/acpi/ibm/fan
INTERVAL=${THINKPAD_FAN_INTERVAL:-1}     # seconds between checks
TCRIT=${THINKPAD_FAN_TCRIT:-90}          # °C, compared in millidegrees

hwmon_by_name() {
    local n
    for n in /sys/class/hwmon/hwmon*; do
        [[ "$(cat "$n/name" 2>/dev/null)" == "$1" ]] && { echo "$n"; return 0; }
    done
    return 1
}

case "${1:-}" in
    full)  cmd="level full-speed"; want="disengaged" ;;
    [0-7]) cmd="level $1";         want="$1" ;;
    *) echo "usage: ${0##*/} 0-7|full" >&2; exit 2 ;;
esac

current_level() { awk '/^level:/{print $2}' "$FAN" 2>/dev/null; }

thinkfan_unit_installed() {
    # LoadState is machine-readable and not localized: loaded, not-found, masked, ...
    local state
    state=$(systemctl show -p LoadState --value thinkfan.service 2>/dev/null) || {
        echo "${0##*/}: failed to query thinkfan.service" >&2
        return 2
    }
    case "$state" in
        loaded) return 0 ;;
        not-found|masked) return 1 ;;
        *) echo "${0##*/}: failed to query thinkfan.service: LoadState '${state}'" >&2; return 2 ;;
    esac
}

restore_automatic() {
    local failed=0
    if ! echo "level auto" > "$FAN"; then
        echo "${0##*/}: failed to restore automatic fan level" >&2
        failed=1
    fi
    if thinkfan_unit_installed; then
        if ! systemctl start thinkfan.service; then
            echo "${0##*/}: failed to start thinkfan.service" >&2
            failed=1
        fi
    else
        local query_rc=$?
        if [[ $query_rc -ne 1 ]]; then
            failed=1
        fi
    fi
    return "$failed"
}

fail_protection() {
    echo "${0##*/}: temperature protection unavailable: $1; restoring automatic control" >&2
    restore_automatic || :
    exit 1
}

CORE=""
if (( TCRIT > 0 )); then
    CORE=$(hwmon_by_name coretemp) || CORE=""
    [[ -n "$CORE" && -r "$CORE/temp1_input" ]] || fail_protection "coretemp sensor is missing or unreadable"
fi

while true; do
    if [[ "$(current_level)" != "$want" ]] && ! echo "$cmd" > "$FAN"; then
        echo "${0##*/}: failed to write fan level; restoring automatic control" >&2
        restore_automatic || :
        exit 1
    fi

    if (( TCRIT > 0 )); then
        [[ -r "$CORE/temp1_input" ]] || fail_protection "coretemp sensor became unreadable"
        if ! read -r t < "$CORE/temp1_input" || [[ ! "$t" =~ ^[0-9]+$ ]]; then
            fail_protection "could not read coretemp temperature"
        fi
        if (( t > TCRIT * 1000 )); then
            echo "${0##*/}: $(( t / 1000 ))°C above ${TCRIT}°C — restoring automatic mode" >&2
            restore_automatic || exit 1
            exit 0
        fi
    fi

    sleep "$INTERVAL"
done
