#!/bin/bash
# Switches the ThinkPad fan mode. Invoked through pkexec by the plasmoid,
# so the argument is validated strictly and nothing else is executed.
#
#   thinkpad-fan-set auto   -- hand control back (thinkfan if installed, else firmware)
#   thinkpad-fan-set 0..7   -- pin a fixed level
#   thinkpad-fan-set full   -- full-speed (disengaged)
#
# Pinning a level stops thinkfan first: otherwise it overwrites the level
# within seconds according to its own curve.
set -u

FAN=/proc/acpi/ibm/fan
HOLD=/usr/local/bin/thinkpad-fan-hold

if [[ ! -w "$FAN" ]]; then
    echo "$FAN is not writable — is thinkpad_acpi loaded with fan_control=1?" >&2
    exit 1
fi

stop_unit_if_loaded() {
    local unit=$1 state status_rc
    state=$(systemctl is-active "$unit" 2>/dev/null)
    status_rc=$?

    case "$state" in
        inactive)
            # systemd reports an unloaded transient unit as inactive with rc 4.
            [[ $status_rc -eq 4 ]] && return 0
            ;;
        unknown)
            [[ $status_rc -eq 4 ]] && return 0
            ;;
        active|failed) ;;
        *)
            echo "failed to determine state of $unit" >&2
            return 1
            ;;
    esac

    if [[ "$state" == failed ]]; then
        systemctl reset-failed "$unit" 2>/dev/null || {
            echo "failed to reset failed state of $unit" >&2
            return 1
        }
    fi
    systemctl stop "$unit" 2>/dev/null || {
        echo "failed to stop $unit" >&2
        return 1
    }
}

thinkfan_unit_installed() {
    local output rc
    output=$(systemctl list-unit-files thinkfan.service 2>&1)
    rc=$?
    if [[ $rc -eq 0 ]]; then
        return 0
    fi
    if grep -Eqi '0 unit files listed|could not be found|not found' <<< "$output"; then
        return 1
    fi
    echo "failed to query thinkfan.service: ${output:-systemctl returned status $rc}" >&2
    return 2
}

start_thinkfan_if_installed() {
    local rc
    if thinkfan_unit_installed; then
        systemctl start thinkfan.service 2>/dev/null || {
            echo "failed to start thinkfan.service" >&2
            return 1
        }
    else
        rc=$?
        [[ $rc -eq 1 ]] || return 1
    fi
}

set_automatic() {
    stop_unit_if_loaded thinkpad-fan-hold.service || return 1
    echo "level auto" > "$FAN" || {
        echo "failed to write automatic fan level" >&2
        return 1
    }
    start_thinkfan_if_installed
}

case "${1:-}" in
    auto)
        set_automatic || exit 1
        ;;
    [0-7]|full)
        stop_unit_if_loaded thinkfan.service || exit 1
        stop_unit_if_loaded thinkpad-fan-hold.service || exit 1
        if ! systemd-run --no-block --unit=thinkpad-fan-hold \
            --description="Hold ThinkPad fan at level $1" \
            "$HOLD" "$1" >/dev/null; then
            echo "failed to start fan hold" >&2
            set_automatic || echo "failed to restore automatic fan control after hold start failure" >&2
            exit 1
        fi

        active=0
        for _ in {1..10}; do
            hold_state=$(systemctl is-active thinkpad-fan-hold.service 2>/dev/null) || hold_rc=$?
            hold_rc=${hold_rc:-0}
            if [[ $hold_state == active && $hold_rc -eq 0 ]]; then
                active=1
                break
            fi
            [[ $hold_state == failed ]] && break
            sleep 0.05
            unset hold_rc hold_state
        done
        # "active" comes as soon as hold is exec'd; its protection checks run
        # right after and exit within milliseconds, so look once more a bit later.
        if [[ $active -eq 1 ]]; then
            sleep 0.3
            [[ $(systemctl is-active thinkpad-fan-hold.service 2>/dev/null) == active ]] || active=0
        fi
        if [[ $active -ne 1 ]]; then
            echo "fan hold failed to become active" >&2
            set_automatic || echo "failed to restore automatic fan control after hold failure" >&2
            exit 1
        fi
        ;;
    *)
        echo "usage: ${0##*/} auto|0-7|full" >&2
        exit 2
        ;;
esac
